#VRML_SIM R2025a utf8
# Minimal arena for PAR (Pulse) to drive a real simulated robot instead of
# MockRobot. See webots/README.md for how to run this.
#
# Verified against a real Webots R2025a install on 2026-09-30. The
# EXTERNPROTO declarations below were required - R2025a no longer resolves
# these built-in node types implicitly, unlike whatever version this file
# was originally hand-authored against (confirmed by running it and reading
# Webots' own "Missing declaration for 'X', add: EXTERNPROTO ..." errors,
# which is also where these exact URLs came from).
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  basicTimeStep 32
  coordinateSystem "ENU"
  # ENU (Z-up) chosen to match PAR's existing (x, y) = ground plane,
  # z = height convention already used throughout par.core / MockRobot.
}
Viewpoint {
  orientation -0.1 0.05 0.99 1.7
  position 0.2 -3.2 2.4
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 4 4
  floorAppearance Parquetry {
  }
}

E-puck {
  translation 0 0 0
  rotation 0 0 1 0
  name "epuck"
  controller "<extern>"
  supervisor TRUE
}

Solid {
  translation 0.5 0.2 0.05
  name "red_object"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.05 0.05
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.1 0.1 0.1
      }
    }
  ]
}

Solid {
  translation -0.3 0.4 0.05
  name "blue_container"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.15 0.8
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.15 0.15 0.1
      }
    }
  ]
}

# The robot the e-puck delegates use_computer to. Physically real, not
# symbolic: a fixed 2-axis (X + Z) gantry presses one of three buttons on a
# small kiosk panel, confirmed by a TouchSensor on the plunger tip - see
# webots/README.md's "physically real computer interaction" section and
# computer_arm_bridge.py, which drives this robot. par_bridge.py's
# dock_at_computer still looks this object up by `name` (now "computer_arm",
# not "laptop") to position the e-puck in front of it - see
# _EpuckBridge._object_position.
#
# Layout (local to this Robot's own origin): a 0.28x0.12x0.10 riser sits on
# the floor, top surface at local z=0.10. Three buttons sit on top of the
# riser, top surface at local z=0.12, at local x = -0.08 / 0 / +0.08. The
# gantry's X+Z carriage is mounted at local z=0.30, well clear of the
# buttons and the riser, and descends onto whichever button is selected by
# its X position. No `physics` on this top-level Robot node - it must stay
# fixed at its authored position for the whole simulation, not just
# initially; only the moving carriage/plunger sub-solids (which a SliderJoint
# actually needs physics on to be actuated by its motor) have `physics`.
Robot {
  translation 1.3 -1.1 0
  name "computer_arm"
  controller "<extern>"
  children [
    Pose {
      translation 0 0 0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.18 0.18 0.19
            roughness 0.4
            metalness 0.2
          }
          geometry DEF RISER Box {
            size 0.28 0.12 0.1
          }
        }
      ]
    }
    Solid {
      translation -0.08 0 0.11
      name "button_check"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.55 0.2
            roughness 0.5
          }
          geometry DEF BUTTON Box {
            size 0.04 0.04 0.02
          }
        }
      ]
      boundingObject USE BUTTON
    }
    Solid {
      translation 0 0 0.11
      name "button_confirm"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.35 0.7
            roughness 0.5
          }
          geometry USE BUTTON
        }
      ]
      boundingObject USE BUTTON
    }
    Solid {
      translation 0.08 0 0.11
      name "button_clear"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.7 0.25 0.2
            roughness 0.5
          }
          geometry USE BUTTON
        }
      ]
      boundingObject USE BUTTON
    }
    Display {
      translation -0.14 0 0.08
      rotation 0 0 1 1.5708
      name "kiosk_screen"
      width 128
      height 64
    }
    SliderJoint {
      jointParameters JointParameters {
        axis 1 0 0
        minStop -0.08
        maxStop 0.08
      }
      device [
        LinearMotor {
          name "gantry_x_motor"
          minPosition -0.08
          maxPosition 0.08
          maxForce 30
        }
        PositionSensor {
          name "gantry_x_position"
        }
      ]
      endPoint Solid {
        translation 0 0 0.3
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.3 0.3 0.3
            }
            geometry Box {
              size 0.03 0.03 0.03
            }
          }
          SliderJoint {
            jointParameters JointParameters {
              axis 0 0 -1
              minStop 0.0
              maxStop 0.19
            }
            device [
              LinearMotor {
                name "gantry_z_motor"
                minPosition 0.0
                maxPosition 0.19
                maxForce 30
              }
              PositionSensor {
                name "gantry_z_position"
              }
            ]
            endPoint Solid {
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.1 0.1 0.1
                  }
                  geometry Cylinder {
                    height 0.03
                    radius 0.006
                  }
                }
                TouchSensor {
                  translation 0 0 -0.015
                  name "plunger_tip"
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 1 0 0
                      }
                      geometry Sphere {
                        radius 0.004
                      }
                    }
                  ]
                  boundingObject Sphere {
                    radius 0.004
                  }
                  physics Physics {
                    density -1
                    mass 0.01
                  }
                  lookupTable [
                    0 0 0
                    0.01 1 0
                  ]
                }
              ]
              boundingObject Cylinder {
                height 0.03
                radius 0.006
              }
              physics Physics {
                density -1
                mass 0.02
              }
            }
          }
        ]
        boundingObject Box {
          size 0.03 0.03 0.03
        }
        physics Physics {
          density -1
          mass 0.1
        }
      }
    }
  ]
  boundingObject Pose {
    translation 0 0 0.05
    children [
      USE RISER
    ]
  }
}
