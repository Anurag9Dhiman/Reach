#VRML_SIM R2025a utf8
# Minimal arena for PAR (Pulse) to drive a real simulated robot instead of
# MockRobot. See webots/README.md for how to run this.
#
# Not yet opened in a real Webots install while writing this (none available
# in the dev environment this was authored in) - if Webots' console flags a
# node/field name here, it is very likely a version-naming mismatch on this
# file, not a deeper problem; fix and re-save.

WorldInfo {
  basicTimeStep 32
  coordinateSystem "ENU"
  # ENU (Z-up) chosen to match PAR's existing (x, y) = ground plane,
  # z = height convention already used throughout par.core / MockRobot.
}
Viewpoint {
  orientation -0.1 0.05 0.99 1.7
  position 0.2 -3.2 2.4
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 4 4
  floorAppearance Parquetry {
  }
}

E-puck {
  translation 0 0 0
  rotation 0 0 1 0
  name "epuck"
  controller "<extern>"
  supervisor TRUE
}

Solid {
  translation 0.5 0.2 0.05
  name "red_object"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.05 0.05
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.1 0.1 0.1
      }
    }
  ]
}

Solid {
  translation -0.3 0.4 0.05
  name "blue_container"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.15 0.8
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.15 0.15 0.1
      }
    }
  ]
}

# The physical stand-in for "the computer" the robot delegates to via
# use_computer. The e-puck has no arm, so it cannot literally type on this -
# see webots/README.md's "symbolic docking" note: par_bridge.py drives the
# robot to a point near this prop and lights an LED for the delegation's
# duration, so the digital hand-off to CollectiveOS reads as something the
# robot is doing (approaching, waiting at, leaving the laptop), not an
# invisible network call. Looked up by `name`, same as red_object/
# blue_container - see _EpuckBridge._object_position.
Solid {
  translation 1.3 -1.1 0.0
  name "laptop"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.18 0.18 0.19
        roughness 0.4
        metalness 0.2
      }
      geometry Box {
        size 0.3 0.2 0.02
      }
    }
    Transform {
      translation 0 -0.095 0.11
      rotation 1 0 0 -1.85
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.11
            roughness 0.3
            metalness 0.3
          }
          geometry Box {
            size 0.3 0.19 0.015
          }
        }
      ]
    }
  ]
}
